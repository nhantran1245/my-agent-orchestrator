# === Local Worker Environment ===

# Database — use Neon DIRECT (non-pooled) URL for long-running worker
DATABASE_URL=postgresql://user:pass@ep-xxx.region.neon.tech:5432/dbname?sslmode=require

# Jira API (for posting PR links as comments)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=your-jira-api-token
JIRA_USER_EMAIL=your-email@company.com

# GitHub CLI (for creating PRs)
GH_TOKEN=ghp_xxxxxxxxxxxx

# === Vercel Environment Variables (set via `vercel env add`) ===
# DATABASE_URL          — Neon pooled connection string (auto-set by Vercel Postgres)
# DIRECT_URL            — Neon direct connection string (auto-set by Vercel Postgres)
# JIRA_WEBHOOK_SECRET   — shared secret for webhook auth
# JIRA_AI_USERNAME      — Jira account ID that triggers jobs
# JIRA_BASE_URL         — https://your-org.atlassian.net
# JIRA_API_TOKEN        — Jira API token
# JIRA_USER_EMAIL       — email for Jira API basic auth
# CALLBACK_SECRET       — shared secret for GitHub callback auth
# CRON_SECRET           — secret for cron job auth (auto-set by Vercel)
#
# NOTE: REPO_MAPPINGS is NOT needed on Vercel.
# Repository mapping is resolved by the local worker via repos.json.
